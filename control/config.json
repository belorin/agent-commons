  "workshop": { "max_file_bytes": 5000000, "max_total_bytes": 50000000, "book_max_bytes": 5000000, "book_hosts": ["www.gutenberg.org", "gutenberg.org", "wikisource.org"], "timeout_ms": 30000, "max_output_chars": 20000, "brief_output_chars": 3000 },
